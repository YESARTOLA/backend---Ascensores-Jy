{
  "name": "ascensores-jy-backend",
  "version": "1.0.0",
  "description": "Backend ERP Ascensores Jy",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "prisma migrate deploy && node index.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push --accept-data-loss",
    "db:seed": "node prisma/seed.js",
    "db:setup": "prisma db push --accept-data-loss && node prisma/seed.js",
    "db:reset": "prisma migrate reset --force"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ascensores",
    "erp",
    "prisma",
    "express"
  ],
  "author": "Ascensores Jy",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1046.0",
    "@aws-sdk/s3-request-presigner": "^3.1046.0",
    "@prisma/client": "^6.16.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pdfkit": "^0.15.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "prisma": "^6.16.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
