# Configuración LOCAL únicamente.
# En Railway las variables se definen desde el servicio (no se usa este archivo).

PORT=4000
NODE_ENV=development
TZ=America/Lima

# Postgres local. En Railway, DATABASE_URL la inyecta el servicio Postgres.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/db_ascensores_jy?schema=public"

# Auth
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=8h

# CORS — en producción: URL exacta del frontend (puede ser lista separada por coma)
CORS_ORIGIN=*

# Legacy pg.Pool (config/db.js)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=db_ascensores_jy
DB_PORT=5432
DB_SSL=false

# ---------------------------------------------------------------------
# ALMACENAMIENTO DE ARCHIVOS (driver)
# STORAGE_DRIVER: 'wasabi' (producción) | 'local' (desarrollo, guarda en disco).
#   Si se deja vacío se autodetecta: 'wasabi' cuando hay credenciales WASABI_*
#   completas, 'local' en caso contrario. En producción, con credenciales, no
#   hace falta tocar nada (queda en 'wasabi').
# UPLOAD_LOCAL_DIR: carpeta del driver local (default: backend/uploads-local).
# ---------------------------------------------------------------------
STORAGE_DRIVER=local
# UPLOAD_LOCAL_DIR=./uploads-local

# ---------------------------------------------------------------------
# WASABI (almacenamiento S3-compatible) — solo si STORAGE_DRIVER=wasabi
# Crea credenciales en https://console.wasabisys.com → Access Keys
# Crea el bucket con: node scripts/setup-wasabi.js
# ---------------------------------------------------------------------
WASABI_ACCESS_KEY=
WASABI_SECRET_KEY=
WASABI_REGION=us-east-1
WASABI_ENDPOINT=https://s3.us-east-1.wasabisys.com
WASABI_BUCKET=ajy-uploads
WASABI_URL_TTL=3600

# ---------------------------------------------------------------------
# UPLOADS — videos y archivos grandes
# UPLOAD_MAX_MB: tamaño máximo permitido por multer (default 200 MB).
# SERVER_REQUEST_TIMEOUT_MS: timeout total del servidor por request (default 15 min).
#   Aplica para uploads desde móviles en conexiones lentas. Railway corta a ~5 min
#   en su proxy edge, así que si se necesita más, considerar uploads directos a Wasabi
#   con presigned PUT URLs en una futura iteración.
# ---------------------------------------------------------------------
UPLOAD_MAX_MB=200
SERVER_REQUEST_TIMEOUT_MS=900000
