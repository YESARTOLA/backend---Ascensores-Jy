// ---------------------------------------------------------------------
// RECORDATORIOS (sistema unificado para programaciones y seguimientos)
// ---------------------------------------------------------------------

model tbl_recordatorios {
  id                     Int                        @id @default(autoincrement())
  titulo                 String                     @db.VarChar(200)
  descripcion            String?
  tipo                   String                     @db.VarChar(30) // 'servicio' | 'mantenimiento' | 'emergencia' | 'cobro' | 'manual'
  origen                 String                     @default("manual") @db.VarChar(20) // 'auto' | 'manual'
  fecha_recordatorio     DateTime                   @db.Timestamptz(6)
  prioridad              String                     @default("media") @db.VarChar(20) // 'alta' | 'media' | 'baja'
  estado_recordatorio    String                     @default("pendiente") @db.VarChar(20) // 'pendiente' | 'atendido' | 'descartado'
  color                  String?                    @db.VarChar(20)
  // Referencias opcionales (al menos una para 'auto', ninguna para 'manual')
  id_servicio            Int?
  id_mantenimiento_plan  Int?
  id_emergencia          Int?
  id_cobro               Int?
  id_cuota               Int?
  // Tracking
  fecha_atendido         DateTime?                  @db.Timestamptz(6)
  atendido_por           Int?
  fecha_lectura          DateTime?                  @db.Timestamptz(6)
  leido_por              Int?
  notas_seguimiento      String?
  // Auditoría
  estado                 Int                        @default(1)
  user_id_registration   Int?
  date_time_registration DateTime?                  @default(now()) @db.Timestamptz(6)
  user_id_modification   Int?
  date_time_modification DateTime?                  @db.Timestamptz(6)
  // Relaciones
  servicio               tbl_servicios_proyectos?   @relation(fields: [id_servicio], references: [id], onDelete: SetNull)
  mantenimiento_plan     tbl_mantenimientos_planes? @relation(fields: [id_mantenimiento_plan], references: [id], onDelete: SetNull)
  emergencia             tbl_emergencias?           @relation(fields: [id_emergencia], references: [id], onDelete: SetNull)
  cobro                  tbl_cobros?                @relation(fields: [id_cobro], references: [id], onDelete: SetNull)
  cuota                  tbl_cobros_cuotas?         @relation(fields: [id_cuota], references: [id], onDelete: Cascade)

  @@index([fecha_recordatorio])
  @@index([estado_recordatorio, fecha_recordatorio])
  @@index([tipo])
  @@index([id_servicio])
  @@index([id_mantenimiento_plan])
  @@index([id_emergencia])
  @@index([id_cobro])
  @@index([id_cuota])
}

