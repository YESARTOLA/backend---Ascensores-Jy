  subtotal               Decimal                  @default(0) @db.Decimal(12, 2)
  igv                    Decimal                  @default(0) @db.Decimal(12, 2)
  igv_tasa               Decimal                  @default(0) @db.Decimal(5, 4)
  monto_total            Decimal                  @default(0) @db.Decimal(12, 2)
  moneda                 String                   @default("PEN") @db.VarChar(10)
  estado_version         String                   @default("Cotizado") @db.VarChar(30)
