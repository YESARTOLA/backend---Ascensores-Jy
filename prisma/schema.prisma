// =====================================================================
// ASCENSORES JY - ERP Operativo
// Esquema Prisma para PostgreSQL
// Convenciones:
//  - Tablas con prefijo tbl_
//  - Auditoría obligatoria al final: user_id_registration, date_time_registration,
//    user_id_modification, date_time_modification
//  - id SERIAL PRIMARY KEY
//  - Todos los TIMESTAMPS en timestamptz(6) (UTC) para evitar desfases en Railway
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------

model tbl_roles {
  id                     Int                  @id @default(autoincrement())
  codigo                 String               @unique @db.VarChar(50)
  nombre                 String               @db.VarChar(100)
  descripcion            String?
  estado                 Int                  @default(1)
  user_id_registration   Int?
  date_time_registration DateTime?            @default(now()) @db.Timestamptz(6)
  user_id_modification   Int?
  date_time_modification DateTime?            @db.Timestamptz(6)
  usuarios               tbl_usuarios[]
  roles_permisos         tbl_roles_permisos[]
}

model tbl_permisos {
  id                     Int                  @id @default(autoincrement())
  codigo                 String               @unique @db.VarChar(100)
  nombre                 String               @db.VarChar(150)
  tipo                   String?              @db.VarChar(50)
  recurso                String?              @db.VarChar(100)
  estado                 Int                  @default(1)
  user_id_registration   Int?
  date_time_registration DateTime?            @default(now()) @db.Timestamptz(6)
  user_id_modification   Int?
  date_time_modification DateTime?            @db.Timestamptz(6)
  roles_permisos         tbl_roles_permisos[]
}

model tbl_roles_permisos {
  id                     Int          @id @default(autoincrement())
  id_rol                 Int
  id_permiso             Int
  estado                 Int          @default(1)
  user_id_registration   Int?
  date_time_registration DateTime?    @default(now()) @db.Timestamptz(6)
  user_id_modification   Int?
  date_time_modification DateTime?    @db.Timestamptz(6)
  rol                    tbl_roles    @relation(fields: [id_rol], references: [id])
  permiso                tbl_permisos @relation(fields: [id_permiso], references: [id])

  @@unique([id_rol, id_permiso])
}

model tbl_usuarios {
  id                     Int           @id @default(autoincrement())
  nombres                String        @db.VarChar(150)
  correo                 String        @unique @db.VarChar(150)
  contrasena             String        @db.VarChar(255)
  id_rol                 Int
  id_tecnico             Int?          @unique
  telefono               String?       @db.VarChar(30)
  ultimo_login           DateTime?     @db.Timestamptz(6)
  estado                 Int           @default(1)
  user_id_registration   Int?
  date_time_registration DateTime?     @default(now()) @db.Timestamptz(6)
  user_id_modification   Int?
  date_time_modification DateTime?     @db.Timestamptz(6)
  rol                    tbl_roles     @relation(fields: [id_rol], references: [id])
  tecnico                tbl_tecnicos? @relation(fields: [id_tecnico], references: [id])
  leads_registrados      tbl_leads[]   @relation("LeadRegistrador")
  leads_como_vendedor    tbl_leads[]   @relation("LeadVendedor")
}

// ---------------------------------------------------------------------
// CLIENTES
// ---------------------------------------------------------------------

model tbl_clientes {
  id                            Int                         @id @default(autoincrement())
  tipo                          String                      @default("Edificio") @db.VarChar(20)
  tipo_documento                String                      @db.VarChar(20)
  numero_documento              String?                     @db.VarChar(30)
  nombre                        String                      @db.VarChar(200)
  nombre_edificio               String?                     @db.VarChar(200)
  telefono                      String?                     @db.VarChar(30)
  whatsapp                      String?                     @db.VarChar(30)
  correo                        String?                     @db.VarChar(150)
  direccion                     String?
  distrito                      String                      @db.VarChar(100)
  latitud                       Decimal?                    @db.Decimal(10, 7)
  longitud                      Decimal?                    @db.Decimal(10, 7)
  contacto_principal_nombre     String?                     @db.VarChar(150)
  contacto_principal_correo     String?                     @db.VarChar(150)
  contacto_principal_telefono   String?                     @db.VarChar(30)
  contacto_cobranzas_nombre     String?                     @db.VarChar(150)
  contacto_cobranzas_correo     String?                     @db.VarChar(150)
  contacto_cobranzas_telefono   String?                     @db.VarChar(30)
  contacto_admin_nombre         String?                     @db.VarChar(150)
  contacto_admin_correo         String?                     @db.VarChar(150)
  contacto_admin_telefono       String?                     @db.VarChar(30)
  observaciones                 String?
  contrato_inicio               DateTime?                   @db.Date
  contrato_fin                  DateTime?                   @db.Date
  id_archivo_contrato           Int?
  clasificacion                 String?                     @db.VarChar(20)
  estado                        Int                         @default(1)
  user_id_registration          Int?
  date_time_registration        DateTime?                   @default(now()) @db.Timestamptz(6)
  user_id_modification          Int?
  date_time_modification        DateTime?                   @db.Timestamptz(6)
  ascensores                    tbl_ascensores[]
  servicios                     tbl_servicios_proyectos[]
  emergencias                   tbl_emergencias[]
  cobros                        tbl_cobros[]
  facturas                      tbl_facturas[]
  historial                     tbl_clientes_historial[]
  mantenimientos                tbl_mantenimientos_planes[]
  leads                         tbl_leads[]
  atenciones_rapidas            tbl_atenciones_rapidas[]
  correctivos                   tbl_correctivos[]
  cotizaciones                  tbl_cotizaciones[]
  archivos                      tbl_clientes_archivos[]
  precios                       tbl_clientes_precios[]
  archivo_contrato              tbl_archivos?               @relation("ClienteContrato", fields: [id_archivo_contrato], references: [id])
}

// Precio configurado por (cliente, tipo de servicio). Se usa como default
// editable al materializar un mantenimiento del calendario. Permite que el
// mismo cliente tenga distintos costos según el tipo de servicio.
model tbl_clientes_precios {
  id                     Int                @id @default(autoincrement())
  id_cliente             Int
  id_tipo_servicio       Int
  precio                 Decimal            @db.Decimal(12, 2)
  moneda                 String             @default("PEN") @db.VarChar(10)
  estado                 Int                @default(1)
  user_id_registration   Int?
  date_time_registration DateTime?          @default(now()) @db.Timestamptz(6)
  user_id_modification   Int?
  date_time_modification DateTime?          @db.Timestamptz(6)
  cliente                tbl_clientes       @relation(fields: [id_cliente], references: [id], onDelete: Cascade)
  tipo_servicio          tbl_tipos_servicio @relation(fields: [id_tipo_servicio], references: [id])

  @@unique([id_cliente, id_tipo_servicio])
  @@index([id_cliente])
}

// Adjuntos libres de un cliente (PDFs, imágenes, documentos varios). El contrato
// firmado se sigue almacenando en tbl_clientes.id_archivo_contrato porque tiene
// semántica especial (filtros por vencimiento); esta tabla cubre los anexos N
// que el usuario quiera mantener: planos, actas, fichas técnicas, etc.
model tbl_clientes_archivos {
  id                     Int           @id @default(autoincrement())
  id_cliente             Int
  id_archivo             Int
  descripcion            String?       @db.VarChar(200)
  orden                  Int           @default(0)
  estado                 Int           @default(1)
  user_id_registration   Int?
  date_time_registration DateTime?     @default(now()) @db.Timestamptz(6)
  user_id_modification   Int?
  date_time_modification DateTime?     @db.Timestamptz(6)
  cliente                tbl_clientes  @relation(fields: [id_cliente], references: [id], onDelete: Cascade)
  archivo                tbl_archivos  @relation(fields: [id_archivo], references: [id])

  @@index([id_cliente])
}

// ---------------------------------------------------------------------
// ASCENSORES
// ---------------------------------------------------------------------

model tbl_ascensores {
  id                     Int                         @id @default(autoincrement())
  id_cliente             Int
  codigo                 String                      @unique @db.VarChar(50)
  ubicacion              String?
  tipo                   String?                     @db.VarChar(50)
  marca                  String?                     @db.VarChar(100)
  modelo                 String?                     @db.VarChar(100)
  capacidad              String?                     @db.VarChar(50)
  pisos                  Int?
  anio_aproximado        Int?
  estado_operativo       String                      @default("Operativo") @db.VarChar(50)
  fecha_instalacion      DateTime?                   @db.Date
  proximo_mantenimiento  DateTime?                   @db.Date
  observaciones          String?
  estado                 Int                         @default(1)
  user_id_registration   Int?
  date_time_registration DateTime?                   @default(now()) @db.Timestamptz(6)
  user_id_modification   Int?
  date_time_modification DateTime?                   @db.Timestamptz(6)
  cliente                tbl_clientes                @relation(fields: [id_cliente], references: [id])
  servicios_ascensores   tbl_servicios_ascensores[]
  emergencias            tbl_emergencias[]
  mantenimientos         tbl_mantenimientos_planes[]
  historial              tbl_ascensores_historial[]
  atenciones_rapidas     tbl_atenciones_rapidas[]
  correctivos            tbl_correctivos[]
  cotizaciones_ascensores tbl_cotizaciones_ascensores[]
}

// ---------------------------------------------------------------------
// TÉCNICOS
// ---------------------------------------------------------------------

model tbl_tecnicos {
  id                     Int                           @id @default(autoincrement())
  nombre                 String                        @db.VarChar(150)
  telefono               String?                       @db.VarChar(30)
  documento              String?                       @db.VarChar(30)
  especialidades         String?
  estado_operativo       String                        @default("Disponible") @db.VarChar(50)
  observaciones          String?
  estado                 Int                           @default(1)
  user_id_registration   Int?
  date_time_registration DateTime?                     @default(now()) @db.Timestamptz(6)
  user_id_modification   Int?
  date_time_modification DateTime?                     @db.Timestamptz(6)
  usuario                tbl_usuarios?
  asignaciones           tbl_servicios_asignaciones[]
  tipos_servicio         tbl_tipos_servicio_tecnicos[]
  checklists             tbl_checklists_salida[]
  guias                  tbl_servicios_guias[]
  evidencias             tbl_servicios_evidencias[]
}

// ---------------------------------------------------------------------
// TIPOS DE ASCENSOR (catálogo gestionable)
// ---------------------------------------------------------------------

model tbl_tipos_ascensor {
  id                     Int       @id @default(autoincrement())
  nombre                 String    @unique @db.VarChar(50)
  descripcion            String?
  estado                 Int       @default(1)
  user_id_registration   Int?
  date_time_registration DateTime? @default(now()) @db.Timestamptz(6)
  user_id_modification   Int?
  date_time_modification DateTime? @db.Timestamptz(6)
}

// ---------------------------------------------------------------------
// TIPOS DE SERVICIO
// ---------------------------------------------------------------------

model tbl_tipos_servicio {
  id                     Int                           @id @default(autoincrement())
  nombre                 String                        @db.VarChar(150)
  categoria              String                        @db.VarChar(50)
  // Módulo operativo al que pertenece este tipo de servicio. Valores permitidos:
  //   'emergencia' | 'correctivo' | 'mantenimiento' | 'atencion_rapida' | null
  // null = tipo "estándar" (Reparación, Revisión, Inspección, Instalación, Proyecto, etc.):
  // el servicio solo vive en tbl_servicios_proyectos.
  // Si está set, al crear el servicio (manual o desde cotización aprobada) se
  // genera además la fila correspondiente en tbl_emergencias / tbl_correctivos /
  // tbl_mantenimientos_planes / tbl_atenciones_rapidas.
  modulo_asociado        String?                       @db.VarChar(30)
  descripcion            String?
  estado                 Int                           @default(1)
  user_id_registration   Int?
  date_time_registration DateTime?                     @default(now()) @db.Timestamptz(6)
  user_id_modification   Int?
  date_time_modification DateTime?                     @db.Timestamptz(6)
  servicios              tbl_servicios_proyectos[]
  tecnicos               tbl_tipos_servicio_tecnicos[]
  mantenimientos         tbl_mantenimientos_planes[]
  leads                  tbl_leads[]
  cotizaciones           tbl_cotizaciones[]
  precios_clientes       tbl_clientes_precios[]
}

model tbl_tipos_servicio_tecnicos {
  id                     Int                @id @default(autoincrement())
  id_tipo_servicio       Int
  id_tecnico             Int
  estado                 Int                @default(1)
  user_id_registration   Int?
  date_time_registration DateTime?          @default(now()) @db.Timestamptz(6)
  user_id_modification   Int?
  date_time_modification DateTime?          @db.Timestamptz(6)
  tipo_servicio          tbl_tipos_servicio @relation(fields: [id_tipo_servicio], references: [id])
  tecnico                tbl_tecnicos       @relation(fields: [id_tecnico], references: [id])

  @@unique([id_tipo_servicio, id_tecnico])
}

// ---------------------------------------------------------------------
// SERVICIOS / PROYECTOS - entidad central
// ---------------------------------------------------------------------

model tbl_servicios_proyectos {
  id                        Int                               @id @default(autoincrement())
  codigo                    String                            @unique @db.VarChar(50)
  tipo_registro             String                            @default("servicio") @db.VarChar(20)
  id_tipo_servicio          Int
  id_cliente                Int
  id_mantenimiento_plan     Int?
  id_cotizacion             Int?
  origen                    String                            @default("directo") @db.VarChar(50)
  titulo                    String                            @db.VarChar(200)
  descripcion               String?
  fecha_programada          DateTime                          @db.Date
  hora_programada           String?                           @db.VarChar(10)
  fecha_estimada_entrega    DateTime?                         @db.Date
  prioridad                 String                            @default("media") @db.VarChar(20)
  estado_servicio           String                            @default("Pendiente") @db.VarChar(50)
  precio_interno            Decimal                           @default(0) @db.Decimal(12, 2)
  moneda                    String                            @default("PEN") @db.VarChar(10)
  sin_cobro                 Int                               @default(0)
  es_mantenimiento_gratuito Int                               @default(0)
  observaciones             String?
  estado                    Int                               @default(1)
  user_id_registration      Int?
  date_time_registration    DateTime?                         @default(now()) @db.Timestamptz(6)
  user_id_modification      Int?
  date_time_modification    DateTime?                         @db.Timestamptz(6)
  tipo_servicio             tbl_tipos_servicio                @relation(fields: [id_tipo_servicio], references: [id])
  cliente                   tbl_clientes                      @relation(fields: [id_cliente], references: [id])
  mantenimiento_plan        tbl_mantenimientos_planes?        @relation(fields: [id_mantenimiento_plan], references: [id])
  cotizacion                tbl_cotizaciones?                 @relation(fields: [id_cotizacion], references: [id])
  ascensores                tbl_servicios_ascensores[]
  asignaciones              tbl_servicios_asignaciones[]
  checklists                tbl_checklists_salida[]
  guias                     tbl_servicios_guias[]
  evidencias                tbl_servicios_evidencias[]
  entregas                  tbl_entregas[]
  servicio_realizado        tbl_servicios_realizados?
  cobro                     tbl_cobros?
  facturas                  tbl_facturas[]
  emergencia                tbl_emergencias?
  correctivo                tbl_correctivos?
  historial_estados         tbl_servicios_estados_historial[]
  eventos_calendario        tbl_calendario_eventos[]
  recordatorios             tbl_recordatorios[]
  observaciones_tecnicas    tbl_servicios_observaciones[]
  finalizacion_checklist    tbl_servicios_finalizacion_checklist?
}

// Observaciones detectadas por el técnico durante la ejecución del servicio
// (sea mantenimiento, emergencia o correctivo). Cada una arroja un recordatorio
// al rol coordinador para seguimiento. El coordinador puede marcarla atendida.
model tbl_servicios_observaciones {
  id                     Int                     @id @default(autoincrement())
  id_servicio            Int
  texto                  String
  id_archivo             Int?
  registrada_por         Int?
  atendida               Int                     @default(0)
  atendida_por           Int?
  fecha_atendida         DateTime?               @db.Timestamptz(6)
  genera_alerta          Int                     @default(0)
  estado                 Int                     @default(1)
  user_id_registration   Int?
  date_time_registration DateTime?               @default(now()) @db.Timestamptz(6)
  user_id_modification   Int?
  date_time_modification DateTime?               @db.Timestamptz(6)
  servicio               tbl_servicios_proyectos @relation(fields: [id_servicio], references: [id], onDelete: Cascade)
  archivo                tbl_archivos?           @relation(fields: [id_archivo], references: [id])

  @@index([id_servicio])
}

model tbl_servicios_ascensores {
  id                     Int                     @id @default(autoincrement())
  id_servicio            Int
  id_ascensor            Int
  monto                  Decimal                 @default(0) @db.Decimal(12, 2)
  moneda                 String                  @default("PEN") @db.VarChar(10)
  estado                 Int                     @default(1)
  user_id_registration   Int?
  date_time_registration DateTime?               @default(now()) @db.Timestamptz(6)
  user_id_modification   Int?
  date_time_modification DateTime?               @db.Timestamptz(6)
  servicio               tbl_servicios_proyectos @relation(fields: [id_servicio], references: [id], onDelete: Cascade)
  ascensor               tbl_ascensores          @relation(fields: [id_ascensor], references: [id])

  @@unique([id_servicio, id_ascensor])
}

model tbl_servicios_asignaciones {
  id                        Int                     @id @default(autoincrement())
  id_servicio               Int
  id_tecnico                Int
  rol_asignacion            String                  @default("Apoyo") @db.VarChar(50)
  responsable_principal     Int                     @default(0)
  responsable_documentacion Int                     @default(0)
  responsable_checklist     Int                     @default(0)
  estado_asignacion         String                  @default("activa") @db.VarChar(30)
  fecha_asignacion          DateTime                @default(now()) @db.Timestamptz(6)
  asignado_por              Int?
  estado                    Int                     @default(1)
  user_id_registration      Int?
  date_time_registration    DateTime?               @default(now()) @db.Timestamptz(6)
  user_id_modification      Int?
  date_time_modification    DateTime?               @db.Timestamptz(6)
  servicio                  tbl_servicios_proyectos @relation(fields: [id_servicio], references: [id], onDelete: Cascade)
  tecnico                   tbl_tecnicos            @relation(fields: [id_tecnico], references: [id])

  @@unique([id_servicio, id_tecnico])
}

// ---------------------------------------------------------------------
// CHECKLIST DE SALIDA
// ---------------------------------------------------------------------

model tbl_checklists_salida {
  id                     Int                           @id @default(autoincrement())
  id_servicio            Int                           @unique
  id_tecnico_responsable Int
  estado_checklist       String                        @default("Pendiente") @db.VarChar(30)
  observaciones          String?
  fecha_completado       DateTime?                     @db.Timestamptz(6)
  validado_por           Int?
  estado                 Int                           @default(1)
  user_id_registration   Int?
  date_time_registration DateTime?                     @default(now()) @db.Timestamptz(6)
  user_id_modification   Int?
  date_time_modification DateTime?                     @db.Timestamptz(6)
  servicio               tbl_servicios_proyectos       @relation(fields: [id_servicio], references: [id], onDelete: Cascade)
  tecnico_responsable    tbl_tecnicos                  @relation(fields: [id_tecnico_responsable], references: [id])
  items                  tbl_checklists_salida_items[]
}

model tbl_checklists_salida_items {
  id                     Int                   @id @default(autoincrement())
  id_checklist           Int
  tipo_item              String                @default("Herramienta") @db.VarChar(30)
  nombre                 String                @db.VarChar(200)
  cantidad               Decimal               @default(1) @db.Decimal(12, 2)
  unidad                 String                @default("Unidad") @db.VarChar(30)
  estado_item            String                @default("Pendiente") @db.VarChar(30)
  observaciones          String?
  estado                 Int                   @default(1)
  user_id_registration   Int?
  date_time_registration DateTime?             @default(now()) @db.Timestamptz(6)
  user_id_modification   Int?
  date_time_modification DateTime?             @db.Timestamptz(6)
  checklist              tbl_checklists_salida @relation(fields: [id_checklist], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------
// GUÍAS Y EVIDENCIAS
// ---------------------------------------------------------------------

model tbl_servicios_guias {
  id                     Int                     @id @default(autoincrement())
  id_servicio            Int
  id_tecnico             Int
  codigo_guia            String?                 @db.VarChar(50)
  id_archivo             Int?
  observaciones_tecnicas String?
  estado_guia            String                  @default("Pendiente") @db.VarChar(30)
  fecha_carga            DateTime                @default(now()) @db.Timestamptz(6)
  estado                 Int                     @default(1)
  user_id_registration   Int?
  date_time_registration DateTime?               @default(now()) @db.Timestamptz(6)
  user_id_modification   Int?
  date_time_modification DateTime?               @db.Timestamptz(6)
  servicio               tbl_servicios_proyectos @relation(fields: [id_servicio], references: [id], onDelete: Cascade)
  tecnico                tbl_tecnicos            @relation(fields: [id_tecnico], references: [id])
  archivo                tbl_archivos?           @relation(fields: [id_archivo], references: [id])
}

model tbl_servicios_evidencias {
  id                     Int                     @id @default(autoincrement())
  id_servicio            Int
  id_tecnico             Int
  id_archivo             Int?
  tipo_evidencia         String                  @default("Foto") @db.VarChar(30)
  descripcion            String?
  fecha_carga            DateTime                @default(now()) @db.Timestamptz(6)
  estado                 Int                     @default(1)
  user_id_registration   Int?
  date_time_registration DateTime?               @default(now()) @db.Timestamptz(6)
  user_id_modification   Int?
  date_time_modification DateTime?               @db.Timestamptz(6)
  servicio               tbl_servicios_proyectos @relation(fields: [id_servicio], references: [id], onDelete: Cascade)
  tecnico                tbl_tecnicos            @relation(fields: [id_tecnico], references: [id])
  archivo                tbl_archivos?           @relation(fields: [id_archivo], references: [id])
}

// ---------------------------------------------------------------------
// SERVICIOS REALIZADOS
// ---------------------------------------------------------------------

model tbl_servicios_realizados {
  id                           Int                     @id @default(autoincrement())
  id_servicio                  Int                     @unique
  id_cliente                   Int
  id_tecnico_principal         Int?
  id_responsable_documentacion Int?
  fecha_realizacion            DateTime                @default(now()) @db.Timestamptz(6)
  observaciones_tecnicas       String?
  descargo_tecnico             String?
  numero_ot                    String?                 @db.VarChar(50)
  id_archivo_ot                Int?
  estado_administrativo        String                  @default("Pendiente revisión") @db.VarChar(50)
  estado_contable              String                  @default("Pendiente") @db.VarChar(50)
  estado_cobro                 String                  @default("Pendiente de iniciar") @db.VarChar(50)
  estado_facturacion           String                  @default("Sin factura") @db.VarChar(50)
  estado                       Int                     @default(1)
  user_id_registration         Int?
  date_time_registration       DateTime?               @default(now()) @db.Timestamptz(6)
  user_id_modification         Int?
  date_time_modification       DateTime?               @db.Timestamptz(6)
  servicio                     tbl_servicios_proyectos @relation(fields: [id_servicio], references: [id], onDelete: Cascade)
  archivo_ot                   tbl_archivos?           @relation("ServicioRealizadoOt", fields: [id_archivo_ot], references: [id])
}

// ---------------------------------------------------------------------
// ENTREGAS
// ---------------------------------------------------------------------

model tbl_entregas {
  id                     Int                     @id @default(autoincrement())
  id_servicio            Int
  tipo_entrega           String                  @db.VarChar(50)
  fecha_entrega          DateTime                @db.Date
  id_responsable_usuario Int?
  descripcion            String?
  id_archivo             Int?
  estado_entrega         String                  @default("Pendiente") @db.VarChar(30)
  estado                 Int                     @default(1)
  user_id_registration   Int?
  date_time_registration DateTime?               @default(now()) @db.Timestamptz(6)
  user_id_modification   Int?
  date_time_modification DateTime?               @db.Timestamptz(6)
