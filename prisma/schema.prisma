  estado                 Int                      @default(1)
  user_id_registration   Int?
  date_time_registration DateTime?                @default(now()) @db.Timestamptz(6)
  user_id_modification   Int?
  date_time_modification DateTime?                @db.Timestamptz(6)
  cotizacion             tbl_cotizaciones         @relation(fields: [id_cotizacion], references: [id], onDelete: Cascade)
  archivo_pdf            tbl_archivos?            @relation("CotizacionVersionPdf", fields: [id_archivo_pdf], references: [id])
  archivo_respaldo       tbl_archivos?            @relation("CotizacionVersionRespaldo", fields: [id_archivo_respaldo], references: [id])
  items                  tbl_cotizaciones_items[]

  @@unique([id_cotizacion, numero_version])
  @@index([estado_version])
}

model tbl_cotizaciones_items {
  id                     Int                        @id @default(autoincrement())
  id_version             Int
  orden                  Int                        @default(0)
  descripcion            String
  cantidad               Decimal                    @default(1) @db.Decimal(12, 2)
  unidad                 String                     @default("Unidad") @db.VarChar(30)
  precio_unitario        Decimal                    @default(0) @db.Decimal(12, 2)
  descuento_porcentaje   Decimal                    @default(0) @db.Decimal(5, 2)
  importe                Decimal                    @default(0) @db.Decimal(12, 2)
  estado                 Int                        @default(1)
  user_id_registration   Int?
  date_time_registration DateTime?                  @default(now()) @db.Timestamptz(6)
  user_id_modification   Int?
  date_time_modification DateTime?                  @db.Timestamptz(6)
  version                tbl_cotizaciones_versiones @relation(fields: [id_version], references: [id], onDelete: Cascade)
}

// Tabla puente cotización ↔ ascensores. Cada cotización puede referir uno o más
// ascensores existentes y/o describir uno o más ascensores nuevos a instalar
// (ascensor_nuevo JSON: { ubicacion, pisos, capacidad, marca, modelo, descripcion }).
// Exactamente uno entre id_ascensor / ascensor_nuevo se llena por fila.
model tbl_cotizaciones_ascensores {
  id                     Int               @id @default(autoincrement())
  id_cotizacion          Int
  id_ascensor            Int?
  ascensor_nuevo         Json?
  orden                  Int               @default(0)
  estado                 Int               @default(1)
  user_id_registration   Int?
  date_time_registration DateTime?         @default(now()) @db.Timestamptz(6)
  user_id_modification   Int?
  date_time_modification DateTime?         @db.Timestamptz(6)
  cotizacion             tbl_cotizaciones  @relation(fields: [id_cotizacion], references: [id], onDelete: Cascade)
  ascensor               tbl_ascensores?   @relation(fields: [id_ascensor], references: [id])

  @@index([id_cotizacion])
}

// ---------------------------------------------------------------------
// CUENTAS BANCARIAS (datos para pago que aparecen en el PDF de cotización)
// ---------------------------------------------------------------------

model tbl_cuentas_bancarias {
  id                     Int         @id @default(autoincrement())
  nombre                 String      @db.VarChar(120)
  banco                  String      @db.VarChar(80)
  tipo_cuenta            String      @db.VarChar(30)
  moneda                 String      @default("PEN") @db.VarChar(10)
  numero_cuenta          String      @db.VarChar(50)
  cci                    String?     @db.VarChar(50)
  titular                String      @db.VarChar(150)
  orden                  Int         @default(0)
  estado                 Int         @default(1)
  user_id_registration   Int?
  date_time_registration DateTime?   @default(now()) @db.Timestamptz(6)
  user_id_modification   Int?
  date_time_modification DateTime?   @db.Timestamptz(6)
  pagos                  tbl_pagos[]
}

// ---------------------------------------------------------------------
// CONFIGURACIÓN (clave/valor, evita hardcodeo)
// ---------------------------------------------------------------------

model tbl_configuracion {
  id                     Int       @id @default(autoincrement())
  clave                  String    @unique @db.VarChar(80)
  valor                  String
  tipo                   String    @default("string") @db.VarChar(20)
  descripcion            String?
  estado                 Int       @default(1)
  user_id_registration   Int?
  date_time_registration DateTime? @default(now()) @db.Timestamptz(6)
  user_id_modification   Int?
  date_time_modification DateTime? @db.Timestamptz(6)
}

// ---------------------------------------------------------------------
// CHECKLIST DE FINALIZACIÓN DE SERVICIO
// Plantilla configurable por categoría (Mantenimiento / Correctivo /
// Emergencia). Cada servicio, al finalizarse, debe completar la plantilla
// activa correspondiente; el resultado alimenta el informe en PDF.
// ---------------------------------------------------------------------

model tbl_checklist_plantillas {
  id                       Int                                  @id @default(autoincrement())
  categoria                String                               @db.VarChar(30) // 'mantenimiento' | 'correctivo' | 'emergencia'
  titulo                   String                               @db.VarChar(150)
  descripcion              String?
  activa                   Int                                  @default(1)
  estado                   Int                                  @default(1)
  user_id_registration     Int?
  date_time_registration   DateTime?                            @default(now()) @db.Timestamptz(6)
  user_id_modification     Int?
  date_time_modification   DateTime?                            @db.Timestamptz(6)
  items                    tbl_checklist_plantilla_items[]
  finalizaciones           tbl_servicios_finalizacion_checklist[]

  @@unique([categoria])
}

model tbl_checklist_plantilla_items {
  id                       Int                                  @id @default(autoincrement())
  id_plantilla             Int
  grupo                    String?                              @db.VarChar(80)
  texto                    String
  orden                    Int                                  @default(0)
  estado                   Int                                  @default(1)
  user_id_registration     Int?
  date_time_registration   DateTime?                            @default(now()) @db.Timestamptz(6)
  user_id_modification     Int?
  date_time_modification   DateTime?                            @db.Timestamptz(6)
  plantilla                tbl_checklist_plantillas             @relation(fields: [id_plantilla], references: [id], onDelete: Cascade)
  respuestas               tbl_servicios_finalizacion_respuestas[]

  @@index([id_plantilla])
}

model tbl_servicios_finalizacion_checklist {
  id                       Int                                  @id @default(autoincrement())
  id_servicio              Int                                  @unique
  id_plantilla             Int
  completado_por           Int?
  id_archivo_pdf           Int?
  estado                   Int                                  @default(1)
  user_id_registration     Int?
  date_time_registration   DateTime?                            @default(now()) @db.Timestamptz(6)
  user_id_modification     Int?
  date_time_modification   DateTime?                            @db.Timestamptz(6)
  servicio                 tbl_servicios_proyectos              @relation(fields: [id_servicio], references: [id], onDelete: Cascade)
  plantilla                tbl_checklist_plantillas             @relation(fields: [id_plantilla], references: [id])
  archivo_pdf              tbl_archivos?                        @relation(fields: [id_archivo_pdf], references: [id])
  respuestas               tbl_servicios_finalizacion_respuestas[]
}

model tbl_servicios_finalizacion_respuestas {
  id                       Int                                  @id @default(autoincrement())
  id_checklist             Int
  id_item                  Int
  respuesta                String                               @db.VarChar(10) // 'si' | 'no' | 'na'
  nota                     String?
  estado                   Int                                  @default(1)
  user_id_registration     Int?
  date_time_registration   DateTime?                            @default(now()) @db.Timestamptz(6)
  user_id_modification     Int?
  date_time_modification   DateTime?                            @db.Timestamptz(6)
  checklist                tbl_servicios_finalizacion_checklist @relation(fields: [id_checklist], references: [id], onDelete: Cascade)
  item                     tbl_checklist_plantilla_items        @relation(fields: [id_item], references: [id])

  @@unique([id_checklist, id_item])
  @@index([id_checklist])
}
